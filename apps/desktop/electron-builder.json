{
  "appId": "com.seuempresa.pdv",
  "productName": "PDVPro",
  "directories": {
    "output": "dist"
  },
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "prisma/schema.prisma"
  ],
  "extraResources": [
    {
      "from": "node_modules/.prisma/client",
      "to": "prisma-client"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "PDV Pro"
  }
}
