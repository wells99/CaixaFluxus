# Variáveis de Ambiente para o Aplicativo Desktop (Electron + React)

# URL do servidor Vite em modo desenvolvimento (usado no apps/desktop/src/main/index.ts)
VITE_DEV_SERVER_URL=http://localhost:5173

# Conexão com a API Cloud (SyncEngine)
VITE_API_BASE_URL=http://localhost:3000/api/v1
API_BASE_URL=http://localhost:3000/api/v1

# Identificação do caixa e tenant
DEVICE_ID=pdv_caixa_01
TENANT_ID=pdv_cliente_1
SYNC_INTERVAL_MS=30000

# SQLite Local (Prisma)
DATABASE_URL="file:./dev.db"

NODE_ENV=development
