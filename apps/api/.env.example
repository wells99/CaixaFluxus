# Variáveis de Ambiente para a API Cloud (Fastify + MySQL Multi-tenant)

# String de conexão do MySQL para o Prisma (apps/api/prisma/schema.prisma)
DATABASE_URL="mysql://root:root@localhost:3306/pdv_master"

# Porta e Host do servidor Fastify
PORT=3000
HOST=0.0.0.0

# Chave secreta JWT para autenticação multi-tenant
JWT_SECRET=sua_chave_secreta_super_segura_jwt_aqui_troque_em_producao

NODE_ENV=development
